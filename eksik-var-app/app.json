{
  "expo": {
    "name": "Eksik Var",
    "slug": "eksik-var-app",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "buildNumber": "4",
      "associatedDomains": [
        "applinks:eksikvarapp.com"
      ],
      "infoPlist": {
        "NSCameraUsageDescription": "Profil fotoğrafı ve dekont için kamera kullanılır.",
        "NSPhotoLibraryUsageDescription": "Profil fotoğrafı, ilan görseli ve dekont seçmek için galeriye erişilir.",
        "NSMicrophoneUsageDescription": "Uygulama içi sesli arama için mikrofon kullanılır.",
        "NSLocationWhenInUseUsageDescription": "Yakınındaki maçları ve sahaları göstermek için konum kullanılır."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "versionCode": 4,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "eksikvarapp.com",
              "pathPrefix": "/e/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-status-bar",
      "expo-audio",
      "expo-sharing",
      "expo-video",
      "expo-font",
      "expo-asset"
    ],
    "scheme": "eksikvar"
  }
}
